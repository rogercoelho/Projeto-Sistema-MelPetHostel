const API_URL = import.meta.env.VITE_API_URL || "http://localhost:3001";

let authToken = null;

import { toISODate } from "../utils/date";

function buildUrl(endpoint) {
  const base = String(API_URL).replace(/\/+$/, "");
  // ensure single slash between base and endpoint
  return `${base}/${String(endpoint).replace(/^\/+/, "")}`;
}

function normalizeDatesInPayload(value) {
  if (value === null || value === undefined) return value;
  if (value instanceof Date) return toISODate(value);
  if (Array.isArray(value)) return value.map(normalizeDatesInPayload);
  if (typeof value === "object") {
    const out = {};
    for (const k of Object.keys(value)) {
      out[k] = normalizeDatesInPayload(value[k]);
    }
    return out;
  }
  if (typeof value === "string") {
    const s = value.trim();
    // quick heuristics: likely date if contains slash or starts with 4-digit year or contains 'T'
    if (
      /^\d{2}\/\d{2}\/\d{4}$/.test(s) ||
      /^\d{4}-\d{2}-\d{2}$/.test(s) ||
      /^\d{4}-\d{2}-\d{2}T/.test(s)
    ) {
      const iso = toISODate(s);
      return iso || value;
    }

    return value;
  }
  return value;
}

async function request(endpoint, options = {}) {
  const headers = {
    "Content-Type": "application/json",
  };

  if (authToken) {
    headers["Authorization"] = `Bearer ${authToken}`;
  }
  // If user info is stored in localStorage (from login), also send x-user header
  try {
    const saved = localStorage.getItem("usuario");
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed) {
        const userId =
          parsed.login ||
          parsed.id ||
          parsed.Usuario_Login ||
          parsed.Usuario_ID;
        if (userId) headers["x-user"] = userId;
      }
    }
  } catch (e) {
    // ignore parsing errors
  }

  const config = {
    headers,
    ...options,
  };

  // If body is present and is a JSON string, normalize date-like fields before sending
  if (config.body && typeof config.body === "string") {
    try {
      const parsed = JSON.parse(config.body);
      const normalized = normalizeDatesInPayload(parsed);
      config.body = JSON.stringify(normalized);
    } catch (e) {
      // not JSON, leave as-is (e.g., FormData or other)
    }
  }

  const response = await fetch(buildUrl(endpoint), config);
  const text = await response.text();

  // Try to parse JSON, otherwise return text (helps debugging when server returns HTML)
  let data;
  try {
    data = text ? JSON.parse(text) : null;
  } catch (err) {
    throw new Error(`Invalid JSON response: ${text.slice(0, 200)}`);
  }

  if (!response.ok) {
    throw new Error(
      data && data.mensagem ? data.mensagem : `Erro: ${response.status}`,
    );
  }

  return data;
}

export const api = {
  get: (endpoint) => request(endpoint),
  post: (endpoint, data) =>
    request(endpoint, { method: "POST", body: JSON.stringify(data) }),
  put: (endpoint, data) =>
    request(endpoint, { method: "PUT", body: JSON.stringify(data) }),
  delete: (endpoint) => request(endpoint, { method: "DELETE" }),
  setToken: (token) => {
    authToken = token;
  },
};

export default api;
