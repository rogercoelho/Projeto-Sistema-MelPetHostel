const API_URL = import.meta.env.VITE_API_URL || "http://localhost:3001";

let authToken = null;

import { toISODate } from "../utils/date";

/* =========================
   Helpers
========================= */

function buildUrl(endpoint) {
  const base = String(API_URL).replace(/\/+$/, "");
  return `${base}/${String(endpoint).replace(/^\/+/, "")}`;
}

function normalizeDatesInPayload(value) {
  if (value === null || value === undefined) return value;

  if (value instanceof Date) {
    return toISODate(value);
  }

  if (Array.isArray(value)) {
    return value.map(normalizeDatesInPayload);
  }

  if (typeof value === "object") {
    const out = {};
    for (const k of Object.keys(value)) {
      out[k] = normalizeDatesInPayload(value[k]);
    }
    return out;
  }

  if (typeof value === "string") {
    const s = value.trim();

    if (s.includes("/") || s.includes("T") || /^\d{4}-\d{2}-\d{2}/.test(s)) {
      const iso = toISODate(s);
      return iso || value;
    }
  }

  return value;
}

function getUserHeader() {
  try {
    const saved = localStorage.getItem("usuario");
    if (!saved) return null;

    const parsed = JSON.parse(saved);

    return (
      parsed.login ||
      parsed.id ||
      parsed.Usuario_Login ||
      parsed.Usuario_ID ||
      null
    );
  } catch {
    return null;
  }
}

function timeoutPromise(ms) {
  return new Promise((_, reject) =>
    setTimeout(() => reject(new Error("Timeout da requisição")), ms),
  );
}

/* =========================
   Core Request
========================= */

async function request(endpoint, options = {}, retry = true) {
  const headers = {
    "Content-Type": "application/json",
  };

  if (authToken) {
    headers["Authorization"] = `Bearer ${authToken}`;
  }

  const userHeader = getUserHeader();
  if (userHeader) {
    headers["x-user"] = userHeader;
  }

  const config = {
    headers,
    ...options,
  };

  if (config.body && typeof config.body === "string") {
    try {
      const parsed = JSON.parse(config.body);
      const normalized = normalizeDatesInPayload(parsed);
      config.body = JSON.stringify(normalized);
    } catch {
      // ignora se não for JSON
    }
  }

  const url = buildUrl(endpoint);

  try {
    const response = await Promise.race([
      fetch(url, config),
      timeoutPromise(20000),
    ]);

    const text = await response.text();

    let data = null;
    try {
      data = text ? JSON.parse(text) : null;
    } catch {
      throw new Error(`Resposta inválida do servidor: ${text.slice(0, 200)}`);
    }

    if (!response.ok) {
      throw new Error(
        data?.mensagem ||
          data?.message ||
          `Erro HTTP ${response.status} em ${endpoint}`,
      );
    }

    return data;
  } catch (err) {
    console.error("API ERROR:", {
      endpoint,
      error: err.message,
    });

    // retry automático para falhas de rede
    if (retry && err.message !== "Timeout da requisição") {
      console.warn("Retry automático da API...");
      return request(endpoint, options, false);
    }

    throw err;
  }
}

/* =========================
   API Export
========================= */

export const api = {
  get: (endpoint) => request(endpoint),

  post: (endpoint, data) =>
    request(endpoint, {
      method: "POST",
      body: JSON.stringify(data),
    }),

  put: (endpoint, data) =>
    request(endpoint, {
      method: "PUT",
      body: JSON.stringify(data),
    }),

  delete: (endpoint) =>
    request(endpoint, {
      method: "DELETE",
    }),

  setToken: (token) => {
    authToken = token;
  },
};

export default api;
